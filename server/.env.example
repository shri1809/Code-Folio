# ==============================================================================
# CodeFolio Server Environment Configuration (.env.example)
# ==============================================================================
# This file documents all environment variables used by the CodeFolio API server.
#
# Local Usage:
#   1. Copy this file to '.env' in your server/ directory:
#        cp server/.env.example server/.env
#   2. Populate with local development values (e.g. local MongoDB).
#
# Production Usage on Render:
#   When deploying via Render Blueprint (render.yaml):
#   - JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, and CSRF_SECRET are auto-generated.
#   - NODE_ENV and PORT are set automatically.
#   - The remaining variables (CLIENT_URL, MONGO_URI, SMTP_EMAIL, SMTP_APP_PASSWORD)
#     must be set in the Render Dashboard under "Environment Variables".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime & Networking
# ------------------------------------------------------------------------------
# Application port. Render injects PORT dynamically; defaults to 5000 locally.
PORT=5000

# Runtime environment: 'development', 'production', or 'test'.
# Set to 'production' on Render.
NODE_ENV=development

# Allowed frontend origin for CORS.
# Set this to your live Vercel production URL (e.g. https://your-codefolio.vercel.app)
# or your custom domain (e.g. https://codefolio.dev).
# IMPORTANT: Must NOT include a trailing slash.
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB connection URI.
# Examples:
#   Local Development: mongodb://127.0.0.1:27017/codefolio
#   Production Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/codefolio?retryWrites=true&w=majority
#
# Requirements for MongoDB Atlas on Render:
#   - Add Render outbound IP ranges (from Render Dashboard -> Settings -> Outbound IP Addresses
#     or regional CIDR blocks) or Dedicated Outbound IP to Atlas Network Access IP Access List.
#   - Avoid 0.0.0.0/0 in production; use only as a brief, temporary connection troubleshooting step.
#   - Database user must have least-privilege 'readWrite' scoped strictly to 'codefolio'.
#   - TLS is automatically enforced with strict certificate validation when NODE_ENV=production.
MONGO_URI=mongodb://127.0.0.1:27017/codefolio

# ------------------------------------------------------------------------------
# 3. Authentication & Cryptographic Secrets
# ------------------------------------------------------------------------------
# Secret keys for signing JWTs and Double-Submit CSRF tokens.
# On Render, these are automatically generated via render.yaml (generateValue: true).
# For manual setup, generate 32+ character random hex strings via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
JWT_ACCESS_SECRET=replace_with_a_secure_random_32_byte_string_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_secure_random_32_byte_string_for_refresh_tokens
CSRF_SECRET=replace_with_a_secure_random_32_byte_string_for_csrf_tokens

# ------------------------------------------------------------------------------
# 4. Email & OTP Verification (Gmail SMTP Relay)
# ------------------------------------------------------------------------------
# Dispatches 6-digit OTP verification codes and public portfolio contact inquiries.
# Requires a 16-character Google App Password (2FA enabled on the sender account).
# In local development (NODE_ENV=development), OTP codes are also printed to the console.
#
SMTP_EMAIL=your_sender_account@gmail.com
SMTP_APP_PASSWORD=your_16_char_google_app_password

# ------------------------------------------------------------------------------
# 5. Testing & Diagnostics (Optional / Test Suite Only)
# ------------------------------------------------------------------------------
# Used only to simulate SMTP network timeout during automated test runs.
TEST_SIMULATE_SMTP_ERROR=false
